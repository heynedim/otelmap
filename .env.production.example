# Copy to .env.production and adjust. .env.production is gitignored.

# Server
PORT=8000
SERVICE_NAME=otel-map-server
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_SECONDS=10

# ClickHouse (host must be the compose service name inside the network)
# CLICKHOUSE_PASSWORD is consumed by the clickhouse/clickhouse-server image;
# it must match the password in CLICKHOUSE_DSN and otel-config.yml.
CLICKHOUSE_PASSWORD=default
CLICKHOUSE_DSN=clickhouse://default:default@clickhouse:9000/default?dial_timeout=5s&compress=true

# Ingest endpoints returned by POST /api/v1/session-token
# Local (http, through nginx / direct collector):
OTLP_HTTP_URL=http://localhost/v1/traces
OTLP_GRPC_URL=http://localhost:4317
# Production (behind TLS termination), e.g.:
# OTLP_HTTP_URL=https://otlp.otelmap.com/v1/traces
# OTLP_GRPC_URL=https://otlp.otelmap.com:4317

# Comma-separated list of allowed CORS origins (* for any)
CORS_ALLOWED_ORIGINS=*
